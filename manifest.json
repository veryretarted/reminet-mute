{
  "manifest_version": 3,
  "name": "remiNET mute",
  "version": "0.13.0",
  "description": "remiNET mute",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://remilia.net/*",
    "*://www.remilia.net/*",
    "*://*.remilia.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "remiNET mute",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://remilia.net/*",
        "*://www.remilia.net/*",
        "*://*.remilia.net/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
